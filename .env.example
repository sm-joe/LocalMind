APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000

QDRANT_HOST=qdrant
QDRANT_PORT=6333

OLLAMA_BASE_URL=http://ollama:11434

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=
# Required by Docker Compose: keep private, never commit real values.
# Generate independent secrets, each with 32+ random characters.
LOCALRAG_API_KEY=
LOCALRAG_ADMIN_PASSWORD=
LOCALRAG_SESSION_SECRET=
