APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000

QDRANT_HOST=qdrant
QDRANT_PORT=6333

OLLAMA_BASE_URL=http://ollama:11434

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
# Lower to 4096 if CPU/RAM is limited.
OLLAMA_NUM_CTX=6144
EMBEDDING_MODEL=nomic-embed-text
# Required by Docker Compose: keep private, never commit real values.
# Prefer LOCALMIND_* for new installs. Existing LOCALRAG_* values still work.
# Do not put real secrets in this tracked example.
POSTGRES_PASSWORD=
# Generate independent secrets, each with 32+ random characters.
LOCALMIND_API_KEY=
LOCALMIND_ADMIN_PASSWORD=
LOCALMIND_SESSION_SECRET=
